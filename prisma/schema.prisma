generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  SELLER
}

model Category {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  description String?
  products    Product[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Log {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  action    String   // e.g. "CREATE_PRODUCT", "UPDATE_CATEGORY"
  target    String   // ID of the target object
  userId    String   @db.ObjectId
  timestamp DateTime @default(now())
}

enum ReactionType {
  LIKE
  DISLIKE
}

enum ImageType {
  PNG
  JPG
  JPEG
  WEBP
  GIF
  SVG
}

model User {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  email    String @unique
  password String
  role     Role   @default(USER)

  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  
  categoryId  String   @db.ObjectId
  category    Category @relation(fields: [categoryId], references: [id])
  
  brand       String?

  price       Float    @default(0)
  stock       Int      @default(0)
  orderCount  Int      @default(0)

  variants   Variant[]
  images     File[]
  comments   Comment[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

type Variant {
  id    String @default(uuid())
  color String
  size  String?
  sku   String
  price Float
  stock Int
  images File[]
  createdAt DateTime @default(now())
}

type File {
  url    String
  format ImageType
  size   Int
  createdAt DateTime @default(now())
}

type Comment {
  id        String   @default(uuid())
  content   String
  rating    Int?
  userId    String   @db.ObjectId
  reactions CommentReaction[]
  replies   CommentReply[]
  createdAt DateTime @default(now())
}

type CommentReply {
  id        String   @default(uuid())
  content   String
  userId    String   @db.ObjectId
  createdAt DateTime @default(now())
}

type CommentReaction {
  id        String   @default(uuid())
  userId    String   @db.ObjectId
  type      ReactionType
  createdAt DateTime @default(now())
}

model Order {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  items  OrderItem[]
  total  Float
  status String // PENDING, PAID, SHIPPED, etc.

  createdAt DateTime @default(now())
}

model OrderItem {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  orderId String @db.ObjectId
  order   Order  @relation(fields: [orderId], references: [id])

  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id])

  variantId String? // Just a string now since Variant is a composite type embedded inside Product

  quantity Int
  price    Float
}
